<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cjym.videoweb.mapper.MenuMapper">

    <!-- ==================== 通用结果映射 ==================== -->
    <resultMap id="BaseResultMap" type="com.cjym.videoweb.model.entity.Menu">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="menu_name" property="menuName" jdbcType="VARCHAR"/>
        <result column="menu_identification" property="menuIdentification" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="BOOLEAN"/>
        <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
        <result column="desc_sort" property="descSort" jdbcType="INTEGER"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="INTEGER"/>
    </resultMap>

    <!-- ==================== MenuDto 结果映射 ==================== -->
    <resultMap id="MenuDtoResultMap" type="com.cjym.videoweb.model.dto.MenuDto">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="menu_name" property="menuName" jdbcType="VARCHAR"/>
        <result column="menu_identification" property="menuIdentification" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="BOOLEAN"/>
        <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
        <result column="desc_sort" property="descSort" jdbcType="INTEGER"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="INTEGER"/>
    </resultMap>

    <!-- ==================== 通用字段列表 ==================== -->
    <sql id="BaseColumnList">
        id, menu_name, menu_identification, status, parent_id, desc_sort, icon, create_time, is_delete
    </sql>

    <!-- ==================== 按菜单名称查询 ==================== -->
    <select id="selectByMenuName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM public.menu
        WHERE menu_name = #{menuName,jdbcType=VARCHAR}
          AND is_delete = 0
    </select>

    <!-- ==================== 一级菜单多条件分页查询（子菜单不参与分页，由 Service 层组装） ==================== -->
    <select id="selectPageList" resultMap="MenuDtoResultMap">
        SELECT m.id, m.menu_name, m.menu_identification, m.status, m.parent_id, m.desc_sort, m.icon,
               m.create_time, m.is_delete
        FROM public.menu m
        <where>
            m.is_delete = 0
            AND (m.parent_id IS NULL OR m.parent_id = 0)
            <if test="menuName != null and menuName != ''">
                AND m.menu_name LIKE CONCAT('%', #{menuName}, '%')
            </if>
            <if test="status != null">
                AND m.status = #{status}
            </if>
        </where>
        ORDER BY m.desc_sort ASC, m.create_time DESC
    </select>

</mapper>

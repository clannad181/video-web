<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cjym.videoweb.mapper.OperationLogMapper">

    <resultMap id="BaseResultMap" type="com.cjym.videoweb.model.entity.OperationLog">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="module" property="module" jdbcType="VARCHAR"/>
        <result column="operation" property="operation" jdbcType="VARCHAR"/>
        <result column="method" property="method" jdbcType="VARCHAR"/>
        <result column="request_uri" property="requestUri" jdbcType="VARCHAR"/>
        <result column="request_method" property="requestMethod" jdbcType="VARCHAR"/>
        <result column="request_params" property="requestParams" jdbcType="VARCHAR"/>
        <result column="ip_address" property="ipAddress" jdbcType="VARCHAR"/>
        <result column="execution_time" property="executionTime" jdbcType="BIGINT"/>
        <result column="result_status" property="resultStatus" jdbcType="INTEGER"/>
        <result column="error_message" property="errorMessage" jdbcType="VARCHAR"/>
        <result column="error_stack_trace" property="errorStackTrace" jdbcType="VARCHAR"/>
        <result column="log_type" property="logType" jdbcType="INTEGER"/>
        <result column="system_type" property="systemType" jdbcType="INTEGER"/>
        <result column="operation_time" property="operationTime" jdbcType="TIMESTAMP"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="INTEGER"/>
    </resultMap>

    <resultMap id="OperationLogPageDtoResultMap" type="com.cjym.videoweb.model.dto.OperationLogPageDto">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="module" property="module" jdbcType="VARCHAR"/>
        <result column="operation" property="operation" jdbcType="VARCHAR"/>
        <result column="method" property="method" jdbcType="VARCHAR"/>
        <result column="request_uri" property="requestUri" jdbcType="VARCHAR"/>
        <result column="request_method" property="requestMethod" jdbcType="VARCHAR"/>
        <result column="ip_address" property="ipAddress" jdbcType="VARCHAR"/>
        <result column="execution_time" property="executionTime" jdbcType="BIGINT"/>
        <result column="result_status" property="resultStatus" jdbcType="INTEGER"/>
        <result column="error_message" property="errorMessage" jdbcType="VARCHAR"/>
        <result column="log_type" property="logType" jdbcType="INTEGER"/>
        <result column="system_type" property="systemType" jdbcType="INTEGER"/>
        <result column="operation_time" property="operationTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectOperationLogPage" resultMap="OperationLogPageDtoResultMap">
        SELECT ol.id, u.user_name AS username, ol.module, ol.operation, ol.method,
               ol.request_uri, ol.request_method, ol.ip_address,
               ol.execution_time, ol.result_status, ol.error_message,
               ol.log_type, ol.system_type, ol.operation_time
        FROM public.operation_log ol
        LEFT JOIN public.user_info u ON ol.user_id = u.id
        <where>
            ol.is_delete = 0
            <if test="username != null and username != ''">
                AND u.user_name LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="module != null and module != ''">
                AND ol.module LIKE CONCAT('%', #{module}, '%')
            </if>
            <if test="logType != null">
                AND ol.log_type = #{logType}
            </if>
            <if test="resultStatus != null">
                AND ol.result_status = #{resultStatus}
            </if>
            <if test="systemType != null">
                AND ol.system_type = #{systemType}
            </if>
            <if test="startTime != null and startTime != ''">
                AND ol.operation_time &gt;= TO_TIMESTAMP(#{startTime}, 'YYYY-MM-DD HH24:MI:SS')
            </if>
            <if test="endTime != null and endTime != ''">
                AND ol.operation_time &lt;= TO_TIMESTAMP(#{endTime}, 'YYYY-MM-DD HH24:MI:SS')
            </if>
        </where>
        ORDER BY ol.operation_time DESC
    </select>

    <!-- 日志统计总览：单次 SQL 同时统计 login_log + operation_log -->
    <resultMap id="LogOverviewMap" type="com.cjym.videoweb.model.vo.LogOverviewVo">
        <result column="loginTotal" property="loginTotal"/>
        <result column="loginSuccess" property="loginSuccess"/>
        <result column="loginFailure" property="loginFailure"/>
        <result column="operationTotal" property="operationTotal"/>
        <result column="businessException" property="businessException"/>
        <result column="systemException" property="systemException"/>
    </resultMap>

    <select id="selectLogOverview" resultMap="LogOverviewMap">
        SELECT
            (SELECT COUNT(*) FROM public.login_log WHERE is_delete = 0) AS "loginTotal",
            (SELECT COUNT(*) FROM public.login_log WHERE is_delete = 0 AND login_status = 1) AS "loginSuccess",
            (SELECT COUNT(*) FROM public.login_log WHERE is_delete = 0 AND login_status = 0) AS "loginFailure",
            (SELECT COUNT(*) FROM public.operation_log WHERE is_delete = 0) AS "operationTotal",
            (SELECT COUNT(*) FROM public.operation_log WHERE is_delete = 0 AND result_status = 1) AS "businessException",
            (SELECT COUNT(*) FROM public.operation_log WHERE is_delete = 0 AND result_status = 0) AS "systemException"
    </select>

    <!-- 运行日志趋势：最近7天按日期聚合（正常/业务异常/系统异常） -->
    <resultMap id="OperationTrendMap" type="com.cjym.videoweb.model.vo.OperationTrendVo">
        <result column="date" property="date"/>
        <result column="normalCount" property="normalCount"/>
        <result column="businessException" property="businessException"/>
        <result column="systemException" property="systemException"/>
    </resultMap>

    <select id="selectOperationTrend" resultMap="OperationTrendMap">
        SELECT
            operation_time::date AS "date",
            COUNT(*) FILTER (WHERE result_status = 2) AS "normalCount",
            COUNT(*) FILTER (WHERE result_status = 1) AS "businessException",
            COUNT(*) FILTER (WHERE result_status = 0) AS "systemException"
        FROM public.operation_log
        WHERE is_delete = 0
          AND operation_time &gt;= CURRENT_DATE - INTERVAL '6 days'
        GROUP BY operation_time::date
        ORDER BY "date"
    </select>

    <!-- 访问IP排行：最近7天访问次数最多的3个IP -->
    <resultMap id="IpRankMap" type="com.cjym.videoweb.model.vo.IpRankVo">
        <result column="ipAddress" property="ipAddress"/>
        <result column="count" property="count"/>
    </resultMap>

    <select id="selectIpRank" resultMap="IpRankMap">
        SELECT ip_address AS "ipAddress", COUNT(*) AS count
        FROM public.operation_log
        WHERE is_delete = 0
          AND operation_time &gt;= CURRENT_DATE - INTERVAL '6 days'
        GROUP BY ip_address
        ORDER BY count DESC
        LIMIT 3
    </select>

    <!-- 每小时活跃用户：最近24小时每小时去重用户数 -->
    <resultMap id="HourlyActiveMap" type="com.cjym.videoweb.model.vo.HourlyActiveVo">
        <result column="hour" property="hour"/>
        <result column="activeCount" property="activeCount"/>
    </resultMap>

    <select id="selectHourlyActiveUsers" resultMap="HourlyActiveMap">
        SELECT TO_CHAR(date_trunc('hour', operation_time), 'HH24:MI') AS hour,
               COUNT(DISTINCT ip_address) AS "activeCount"
        FROM public.operation_log
        WHERE is_delete = 0
          AND system_type = 0
          AND operation_time &gt;= date_trunc('hour', NOW()) - INTERVAL '23 hours'
        GROUP BY date_trunc('hour', operation_time)
        ORDER BY date_trunc('hour', operation_time)
    </select>

</mapper>
